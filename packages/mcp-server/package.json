{
  "name": "@hsmkit/mcp-server",
  "mcpName": "io.github.hsm-kit/hsmkit",
  "version": "0.1.0",
  "description": "Local-first MCP server for HSM Kit encoding, check-digit, key-component, and payment test-data tools.",
  "type": "module",
  "license": "MIT",
  "author": "HSM Kit Editorial Team",
  "homepage": "https://hsmkit.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsm-kit/hsmkit.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/hsm-kit/hsmkit/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "cryptography",
    "hsm",
    "payment-security",
    "luhn",
    "pin-block"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hsmkit-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod 755 dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hsmkit/crypto-tools": "0.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7"
  }
}
